# Production database — used ONLY by `pnpm db:push:prod`.
# Copy to `.env.prod` and fill in. `.env.prod` is git-ignored.
#
# Supabase → Project Settings → Database → Connection string (URI).
# Use the direct (session) connection, not the transaction pooler, for schema pushes.

DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
