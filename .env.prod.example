# Production database — used ONLY by `pnpm db:push:prod` and prod seeds.
# Copy to `.env.prod` and fill in. `.env.prod` is git-ignored.
#
# Vercel Postgres (Neon) → use the DIRECT (unpooled) connection string for
# schema pushes, not the pooled one. In `vercel env pull` output this is
# DATABASE_URL_UNPOOLED.
#
# The app runtime does NOT read this file — it uses the pooled DATABASE_URL
# configured in the Vercel project settings (plus AUTH_SECRET,
# ADMIN_PASSWORD_HASH and the R2_* vars, all set in the Vercel dashboard).

DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
