# Local development environment.
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.

# Local Postgres from docker-compose.yml (pnpm db:up)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/postgres

# Cloudflare R2
R2_BUCKET_PUBLIC_URL=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Admin auth (single user)
# AUTH_SECRET: random string, e.g. `openssl rand -base64 32`
AUTH_SECRET=
# ADMIN_PASSWORD_HASH: argon2 hash, generate with `pnpm auth:hash '<password>'`
ADMIN_PASSWORD_HASH=
