# Local development environment.
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.

# Local Postgres from docker-compose.yml (pnpm db:up)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/postgres

# Supabase (service role)
SUPABASE_KEY=
SUPABASE_URL=

# Supabase (anon / public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2
R2_BUCKET_PUBLIC_URL=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
