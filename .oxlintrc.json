{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": [
        "typescript",
        "unicorn",
        "oxc",
        "react",
        "nextjs",
        "import",
        "jsx-a11y"
    ],
    "jsPlugins": [
        "eslint-plugin-tailwindcss",
        {"name": "import-js", "specifier": "eslint-plugin-import-x"}
    ],
    "categories": {
        "correctness": "error"
    },
    "settings": {
        "tailwindcss": {
            "cssConfigPath": "src/app/globals.css"
        }
    },
    "ignorePatterns": [
        ".next/**",
        "node_modules/**",
        "server/**",
        "scripts/**",
        "public/**",
        "next-env.d.ts"
    ],
    "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn",
        "react/react-in-jsx-scope": "off",
        "react/purity": "warn",
        "nextjs/no-img-element": "warn",
        "import/no-anonymous-default-export": "warn",
        "no-unused-vars": [
            "warn",
            {
                "ignoreRestSiblings": true,
                "argsIgnorePattern": "^_",
                "varsIgnorePattern": "^_"
            }
        ],
        "unicorn/no-new-array": "off",
        "unicorn/no-empty-file": "warn",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-static-element-interactions": "off",
        "jsx-a11y/control-has-associated-label": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/iframe-has-title": "off",
        "tailwindcss/classnames-order": "warn",
        "tailwindcss/enforces-canonical-classname": "warn",
        "tailwindcss/enforces-negative-arbitrary-values": "warn",
        "tailwindcss/enforces-shorthand": "warn",
        "tailwindcss/important-modifier-suffix": "warn",
        "tailwindcss/no-custom-classname": [
            "warn",
            {
                "whitelist": [
                    // Kivo component classes of the admin (src/admin/css)
                    "kv-.*",
                    // the plugin reports identifiers passed to clsx() by their name
                    "className",
                    "classes"
                ]
            }
        ],
        "tailwindcss/no-contradicting-classname": "error",
        "tailwindcss/no-unnecessary-arbitrary-value": "warn",
        "import-js/order": [
            "error",
            {
                "groups": [
                    "type",
                    "object",
                    "builtin",
                    "external",
                    "internal",
                    ["parent", "sibling"],
                    "index"
                ],
                "pathGroups": [
                    {"pattern": "react", "group": "builtin", "position": "before"},
                    {"pattern": "@/*/**", "group": "internal", "position": "before"}
                ],
                "newlines-between": "always",
                "pathGroupsExcludedImportTypes": ["react"],
                "warnOnUnassignedImports": true
            }
        ]
    }
}
